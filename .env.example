# ============================================================
# ALKAPRELOVED — Environment Variables Template
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================

# ─── Supabase (Public — safe for browser) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Supabase (Server-only — NEVER expose to browser) ───────
# Used only in Server Actions and API Routes (server-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Site URL ────────────────────────────────────────────────
# Set to your production domain on Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Shipping API (Server-only) ──────────────────────────────
# Will be filled when the real shipping API is provided
SHIPPING_API_URL=
SHIPPING_API_KEY=

# ─── Payment Gateway (Server-only) ───────────────────────────
# Will be filled when the real payment gateway is provided
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ─── Tracking API (Server-only) ──────────────────────────────
# Will be filled when the real tracking API is provided
TRACKING_API_URL=
TRACKING_API_KEY=
